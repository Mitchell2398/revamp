# Example environment variables file
# Copy this to .env and update with your actual API keys

# Lua API Key (optional - fallback if not in keychain)
# Use this for CI/CD environments or if you prefer .env over keychain
# Priority: 1. Keychain, 2. Environment variable, 3. .env file
# LUA_API_KEY=your-lua-api-key-here

# Email Agent outbound email settings
# Required for real sends. The agent blocks instead of pretending to send when these are missing.
EMAIL_FROM="Finn from Revamp <finn@your-domain.com>"
EMAIL_REPLY_TO="finn@your-domain.com"

# Option 1: Resend
RESEND_API_KEY=your-resend-api-key-here

# Option 2: Your own email webhook
# SEND_EMAIL_WEBHOOK_URL=https://your-email-service.example/send
# SEND_EMAIL_WEBHOOK_SECRET=your-webhook-secret

# Local safety switch. Set to false or remove in production.
EMAIL_DRY_RUN=true

# Note: Values in lua.skill.yaml will override values in this .env file
